# PostgreSQL (use a pooled connection string on serverless)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# At least 32 random characters; never expose to the browser
AUTH_SECRET=
APP_URL=http://localhost:3000

# Server-only Google Gemini configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Cloudflare R2 / S3-compatible audio storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL_BASE=
