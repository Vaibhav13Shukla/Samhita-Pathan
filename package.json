    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.2",
    "jose": "^6.2.12",
    "lucide-react": "^1.54.0",
    "next": "^16.4.0",
    "pg": "8.20.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "source-map-js": "^1.2.2",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
